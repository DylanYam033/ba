# Copia este archivo como .env.local (está en .gitignore) y completa los valores.
# Si cambias algo aquí, vuelve a ejecutar `npx expo run:android`.

# URL pública del API (por ejemplo la de ngrok), terminada en /api.
EXPO_PUBLIC_API_URL=https://tu-subdominio.ngrok-free.dev/api

# Key de Google Maps para Android. Sin ella la app funciona, pero el mapa sale en blanco.
GOOGLE_MAPS_API_KEY=
